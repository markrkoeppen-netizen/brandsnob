# Dependencies
node_modules/

# Environment variables (NEVER commit this!)
.env
.env.local

# Build output (regenerated by npm run build)
dist/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Firebase service account (NEVER commit this!)
*-firebase-adminsdk-*.json
serviceAccountKey.json

# Local backup files created during editing sessions
src/*.backup
src/*.backup*

# Xcode user-specific files (safe to regenerate, clutters commits)
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
ios/**/xcuserdata/
