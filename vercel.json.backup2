{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/wishlist/:shareId",
      "destination": "/wishlist.html"
    },
    {
      "source": "/deals/:slug",
      "destination": "/deals-post.html"
    },
    {
      "source": "/deals",
      "destination": "/deals-index.html"
    },
    {
      "source": "/((?!api|assets|wishlist|privacy|terms|about|contact|deals).*)",
      "destination": "/index.html"
    }
  ]
}
